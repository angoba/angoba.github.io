---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<BaseLayout title={note.data.title}>
  <article>
    <h1 class="simple-page-title">{note.data.title}</h1>
    <p class="meta">{note.data.date}</p>
    <Content />
  </article>
  <a class="back-link" href="/notes/">Back to notes</a>
</BaseLayout>
