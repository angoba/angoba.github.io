---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { materialPages } from '../../data/material-pages';

export async function getStaticPaths() {
  return Object.keys(materialPages).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as keyof typeof materialPages;
const page = materialPages[slug];
if (!page) throw new Error(`Unknown materials page: ${slug}`);
const hasSections = page.sections.length > 0;
---
<BaseLayout title={page.title}>
  <article class="material-page">
    <h1 class="simple-page-title">{page.title}</h1>
    {hasSections ? page.sections.map((section) => (
      <section class="material-block">
        <h2>{section.title}</h2>
        <ul class="material-list">
          {section.items.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </section>
    )) : <p class="empty-content">Materials will be added here.</p>}
  </article>
  <a class="back-link" href="/">Back to home</a>
</BaseLayout>
