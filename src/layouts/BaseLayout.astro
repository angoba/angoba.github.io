---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
interface Props {
  title?: string;
}
const { title = 'The Far Side' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Juan Barrero — statistics, mathematics, programming and course notes." />
  </head>
  <body>
    <main class="page-shell">
      <NavBar />
      <slot />
    </main>
  </body>
</html>
