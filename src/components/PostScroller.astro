---
interface Item {
  href: string;
  label: string;
  meta?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="post-scroller">
  {items.length === 0 && <p class="empty-content">No posts yet.</p>}
  <ul class="post-list">
    {items.map((item) => (
      <li>
        <a class="post-row" href={item.href}>
          <span class="post-title">{item.label}</span>
          <span class="post-date">{item.meta}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
