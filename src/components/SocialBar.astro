---
interface Item {
  href: string;
  label: string;
  icon: 'github' | 'youtube' | 'linkedin';
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

function getPath(icon: Item['icon']) {
  if (icon === 'github') {
    return 'M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.25 9.28 7.76 10.79.57.1.78-.25.78-.55 0-.27-.01-.99-.02-1.94-3.15.68-3.81-1.52-3.81-1.52-.51-1.3-1.26-1.64-1.26-1.64-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.66 1.23 3.31.94.1-.73.39-1.23.71-1.51-2.52-.29-5.18-1.26-5.18-5.62 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.46.11-3.05 0 0 .95-.31 3.12 1.16a10.88 10.88 0 0 1 5.68 0c2.17-1.47 3.12-1.16 3.12-1.16.62 1.59.23 2.76.11 3.05.73.8 1.17 1.81 1.17 3.05 0 4.37-2.66 5.33-5.2 5.61.4.35.76 1.05.76 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.79.55A11.01 11.01 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z';
  }
  if (icon === 'youtube') {
    return 'M23.5 6.2a2.93 2.93 0 0 0-2.06-2.08C19.57 3.6 12 3.6 12 3.6s-7.57 0-9.44.52A2.93 2.93 0 0 0 .5 6.2 30.3 30.3 0 0 0 0 12a30.3 30.3 0 0 0 .5 5.8 2.93 2.93 0 0 0 2.06 2.08C4.43 20.4 12 20.4 12 20.4s7.57 0 9.44-.52a2.93 2.93 0 0 0 2.06-2.08A30.3 30.3 0 0 0 24 12a30.3 30.3 0 0 0-.5-5.8ZM9.6 15.66V8.34L15.84 12 9.6 15.66Z';
  }
  return 'M4.98 3.5A1.75 1.75 0 1 1 4.97 7a1.75 1.75 0 0 1 0-3.5ZM3.5 8.75h2.95v9.75H3.5V8.75ZM8.3 8.75h2.82v1.33h.04c.39-.74 1.35-1.52 2.79-1.52 2.99 0 3.55 1.97 3.55 4.53v5.41h-2.94v-4.8c0-1.14-.02-2.62-1.6-2.62-1.6 0-1.85 1.25-1.85 2.54v4.88H8.3V8.75Z';
}
---
<div class="social-bar">
  {items.map((item) => (
    <a class="social-link" href={item.href} aria-label={item.label} title={item.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d={getPath(item.icon)}></path>
      </svg>
    </a>
  ))}
</div>
